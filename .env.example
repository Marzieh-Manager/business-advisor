# POMEAI Advisor - configuration
# Copy this file to .env and fill in the values. Never commit .env.
#
# Milestone 0 needs NONE of these to be set - `check` runs without them.
# Each key is annotated with the milestone that first requires it.

# --- Capture: Telegram (Milestone 1) ---
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Lock the bot to a single Telegram user. This is a single-user system by design;
# the bot ignores messages from any other chat id.
# Find yours by messaging @userinfobot.
TELEGRAM_OWNER_CHAT_ID=

# Who gets told when something breaks. Outbound ONLY - this chat is never added
# to the inbound allow-list, so being alerted does not let you send notes into
# the owner's week. Without it a failed transcription is completely silent: the
# owner sees a green tick and the note quietly never reaches the report.
TELEGRAM_ALERT_CHAT_ID=

# Days of silence before the operator is alerted and the owner gets one soft
# nudge. Three days into a Mon-Sun week still leaves him time to contribute.
SILENCE_ALERT_DAYS=3

# --- Transcription (Milestone 2) ---
# Provider is swappable - Persian ASR accuracy is a known risk. Set whichever
# key(s) you have; `cli compare` runs both on the same audio to settle which
# actually transcribes the owner's Persian better.
TRANSCRIPTION_PROVIDER=whisper   # whisper | gemini

# Whisper - works with a direct OpenAI key, or any OpenAI-compatible gateway.
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
#
# Using an OpenRouter key instead? Set these two as well:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   WHISPER_MODEL=openai/whisper-large-v3
# Gateways namespace their model ids, so a bare "whisper-1" is rejected.
# NOTE: OpenRouter accepts but IGNORES the `prompt` parameter on file uploads,
# so the business's domain vocabulary (supplier and product names) is dropped.
# If those terms come back mangled, a direct OpenAI key will do better.
OPENAI_BASE_URL=

# Gemini - Google's native API, no gateway involved.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Advisor (Milestone 4) ---
ANTHROPIC_API_KEY=
# Quality matters more than cost here - the report runs once a week.
ANTHROPIC_MODEL=claude-opus-5

# --- Reporting ---
# The owner's business operates in Australia; weekday labels and the weekly
# window are computed in this timezone.
REPORT_TIMEZONE=Australia/Sydney
# Which day the reporting week starts on: monday | saturday | sunday
# Confirmed with the owner: Monday, the Australian business week.
WEEK_START=monday

# --- Delivery (Milestone 5) ---
# The report is delivered at the START of each week and covers the week just
# finished, so the owner reads it while planning the week ahead.
REPORT_DELIVERY_TIME=08:00

# --- Logging ---
LOG_LEVEL=INFO
